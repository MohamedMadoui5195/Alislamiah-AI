<div id="chat-view" class="h-screen flex flex-col bg-white">
    <!-- سجل المحادثة -->
    <div id="chat-history" class="flex-grow p-4 overflow-y-auto flex flex-col space-y-4">
        <!-- هنا ستظهر الرسائل تلقائياً -->
    </div>

    <!-- شريط الإدخال -->
    <div class="p-4 border-t">
        <div class="flex items-center border border-gray-300 rounded-full p-1 shadow-inner">
            <input type="text" id="ai-input" class="flex-grow px-4 py-2 outline-none rounded-full" placeholder="اكتب سؤالك...">
            <button onclick="handleSend()" class="text-white px-6 py-2 rounded-full font-bold" style="background: linear-gradient(to right, #833ab4, #fd1d1d, #fcaf45);">
                إرسال
            </button>
        </div>
    </div>
</div>

<script>
async function handleSend() {
    const input = document.getElementById('ai-input');
    const history = document.getElementById('chat-history');
    const query = input.value.trim();
    if (!query) return;

    // 1. عرض رسالة المستخدم
    history.innerHTML += `<div class="user-bubble">${query}</div>`;
    input.value = "";

    // 2. محرك البحث (يستدعي منطقك في logic.js)
    let response = await processUserMessage(query); 
    
    // 3. عرض رد المساعد
    history.innerHTML += `<div class="ai-bubble">${response}</div>`;
    history.scrollTop = history.scrollHeight;
}
</script>
